#!/bin/sh
# Deterministic stand-in for the `claude` executable in one-shot
# `--print --output-format json` mode. It never execs a real CLI, reads no
# credentials and makes no network calls.
#
# FAKE_CLAUDE_SCENARIO selects the output. FAKE_CLAUDE_CALLS, when set, gets
# one line per invocation (the NUL-free argv) so tests can assert how many
# processes were started.
#
# All scenarios are synthetic. Field names follow the terminal `result`
# object that ClaudeWrapper.Result.from_json/1 parses; values are not
# captured from a provider.

if [ -n "$FAKE_CLAUDE_CALLS" ]; then
  printf '%s\n' "$*" >> "$FAKE_CLAUDE_CALLS"
fi

base='"type":"result","session_id":"fake-session","duration_ms":1,"num_turns":1,"total_cost_usd":0'

case "$FAKE_CLAUDE_SCENARIO" in
  object)
    printf '{%s,"subtype":"success","is_error":false,"result":"","structured_output":{"name":"Ada Lovelace"}}\n' "$base"
    ;;
  array)
    printf '{%s,"subtype":"success","is_error":false,"result":"","structured_output":[{"name":"Ada"},{"name":"Grace"}]}\n' "$base"
    ;;
  missing)
    printf '{%s,"subtype":"success","is_error":false,"result":"plain text"}\n' "$base"
    ;;
  null)
    printf '{%s,"subtype":"success","is_error":false,"result":"","structured_output":null}\n' "$base"
    ;;
  scalar)
    printf '{%s,"subtype":"success","is_error":false,"result":"","structured_output":"Ada Lovelace"}\n' "$base"
    ;;
  env_probe)
    # Reports the auto-memory switch hermetic sets (#327) as the result text.
    printf '{%s,"subtype":"success","is_error":false,"result":"auto_memory_off=%s"}\n' "$base" "${CLAUDE_CODE_DISABLE_AUTO_MEMORY-<unset>}"
    ;;
  api_429|api_529|api_503|api_401|api_403)
    # Claude Code 2.1.312's result for a turn that hit an HTTP API error.
    status=${FAKE_CLAUDE_SCENARIO#api_}
    printf '{"type":"result","session_id":"fake-session","duration_ms":1,"num_turns":%s,"total_cost_usd":0,"subtype":"success","is_error":true,"api_error_status":%s,"terminal_reason":"api_error","result":"API Error: synthetic %s"}\n' "${FAKE_CLAUDE_NUM_TURNS:-1}" "$status" "$status"
    exit 1
    ;;
  max_turns)
    printf '{%s,"subtype":"error_max_turns","is_error":true,"result":"Reached maximum number of turns (1)"}\n' "$base"
    exit 1
    ;;
  api_connection)
    printf '{%s,"subtype":"success","is_error":true,"terminal_reason":"api_error","result":"API Error: Connection error."}\n' "$base"
    exit 1
    ;;
  native_error)
    # A native failure that still carries a partial object.
    printf '{%s,"subtype":"error_max_structured_output_retries","is_error":true,"result":"","structured_output":{"name":"partial"}}\n' "$base"
    exit 1
    ;;
  malformed)
    printf '{%s,"subtype":"success","is_error":false,"structured_output":{"name":\n' "$base"
    ;;
  crash)
    printf 'fake claude: synthetic crash\n' >&2
    exit 2
    ;;
  *)
    printf 'fake claude: unknown FAKE_CLAUDE_SCENARIO %s\n' "$FAKE_CLAUDE_SCENARIO" >&2
    exit 64
    ;;
esac
